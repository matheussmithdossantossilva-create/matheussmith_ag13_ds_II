<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppHotel.SobrePage"
    Title="Sobre">

    <VerticalStackLayout
        Padding="25"
        Spacing="22"
        BackgroundColor="#F3F6FA"
        VerticalOptions="Center">

        <Label Text="HOTEL PREMIUM"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="#17365D"
               HorizontalOptions="Center"/>

        <Label Text="Sobre o aplicativo"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#17365D"
               HorizontalOptions="Center"/>

        <Label Text="Este aplicativo foi desenvolvido para facilitar o processo de reservas de hospedagem, permitindo escolher datas, quartos e quantidade de hóspedes."
               FontSize="17"
               TextColor="#333333"
               HorizontalTextAlignment="Center"/>

        <BoxView HeightRequest="2"
                 Color="#D6A84F"/>

        <Label Text="Desenvolvedor"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="#17365D"
               HorizontalOptions="Center"/>

        <Label Text="Matheus Smith dos Santos Silva"
               FontSize="18"
               TextColor="#333333"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

        <Label Text="Ano de desenvolvimento: 2026"
               FontSize="16"
               TextColor="#333333"
               HorizontalOptions="Center"/>

        <Label Text="Projeto desenvolvido em C# utilizando .NET MAUI."
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"/>

        <Button Text="Voltar"
                BackgroundColor="#17365D"
                TextColor="White"
                CornerRadius="12"
                Clicked="OnVoltarClicked"/>

    </VerticalStackLayout>
</ContentPage>
